# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# FIREBASE FIRESTORE CLOUD CONFIGURATION (Zero-Disk Storage for Render / Production)
# ==============================================================================
# In your Render Web Service Dashboard -> Environment -> Environment Variables,
# add the following variables. This allows the app to store all contest songs,
# judge scores, flags, and settings in Firebase Firestore without paying for a disk.

# 1. Firebase Project ID (from Firebase Console Project Settings)
FIREBASE_PROJECT_ID="supple-hulling-g3kqt"

# 2. Firebase Web API Key
FIREBASE_API_KEY="AIzaSyDfKB90nPzHtpFMarJiPKuxsSTpP7A_L4U"

# 3. Firebase Auth Domain
FIREBASE_AUTH_DOMAIN="supple-hulling-g3kqt.firebaseapp.com"

# 4. Firestore Database ID (Optional, defaults to "(default)" or your custom database)
FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-remixremixremixr-04e40b5b-d896-4399-b950-5472ce458c40"

# 5. Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET="supple-hulling-g3kqt.firebasestorage.app"

# 6. Firebase Messaging Sender ID
FIREBASE_MESSAGING_SENDER_ID="1038668654986"

# 7. Firebase Web App ID
FIREBASE_APP_ID="1:1038668654986:web:a8bb60c29a8dc63e700073"

# Node Environment
NODE_ENV="production"
PORT=3000
